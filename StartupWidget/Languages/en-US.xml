<?xml version="1.0" encoding="utf-8" ?>
<Language>
	<MainWindow Text="StartupWidget">
		<MainMenu>
			<Options Text="Options(_O)">
				<ShowWidget Text="Show Widget(_W)"/>
				<Settings Text="Settings(_S)"/>
				<Quit Text="Quit(_Q)"/>
			</Options>
		</MainMenu>
		<RightClickMenu>
			<Run Text="Run(_R)"/>
			<RunAsAdmin Text="Run as administrator(_A)"/>
			<Edit Text="Edit(_E)"/>
			<EditItem Text="Edit app item(_E)"/>
		</RightClickMenu>
	</MainWindow>
	<Widget>
		<RightClickMenu>
			<Run Text="Run(_R)"/>
			<RunAsAdmin Text="Run as administrator(_A)"/>
			<Edit Text="Edit(_E)"/>
			<IsFixed Text="Pin widget(_P)"/>
			<IsMagnet Text="Snap to screen edges(_G)"/>
			<ShowMainWindow Text="Show main window(_M)"/>
			<ShowSettings Text="Settings(_S)"/>
			<MinimizeWidget Text="Minimize widget(_I)"/>
		</RightClickMenu>
	</Widget>
	<SettingsWindow Text="Settings">
		<GeneralSettings Text="General Settings">
			<Font Text="Font"/>
			<Language Text="Language"/>
			<IconSize Text="Icon size"/>
			<IsStartup Text="Start at login"/>
		</GeneralSettings>
		<MainWindowSettings Text="Main Window Settings">
			<BackgroundImageFilePath Text="Background image path"/>
			<BackgroundImageFileOption Text="Image file"/>
			<ForegroundColor Text="Text color"/>
			<BackgroundColor Text="Background color"/>
		</MainWindowSettings>
		<WidgetSettings Text="Widget Settings">
			<BackgroundImageFilePath Text="Background image path"/>
			<BackgroundImageFileOption Text="Image file"/>
			<ForegroundColor Text="Text color"/>
			<BackgroundColor Text="Background color"/>
			<WindowSize Text="Window size"/>
			<Transparency Text="Transparency (%)"/>
			<IsFixed Text="Pin widget"/>
			<IsMagnet Text="Snap to screen edges"/>
			<MagnetThreshold Text="Magnet threshold"/>
			<ShortcutKeys Text="Shortcut keys"/>
			<ShortcutKeysInputRequest Text="Press keys..."/>
		</WidgetSettings>
		<FooterButtons>
			<OK Text="OK(_O)"/>
			<Apply Text="Apply(_A)"/>
			<Cancel Text="Cancel(_C)"/>
		</FooterButtons>
		<MessageBox>
			<FailedStartUp Text="Failed to register startup."/>
		</MessageBox>
	</SettingsWindow>
	<EditWindow Text="Edit Application">
		<AddButton Text="Add New"/>
		<Elements>
			<Name Text="Name"/>
			<FilePath Text="Executable path"/>
			<FilePathDialogFilter Text="Executable files"/>
			<Arguments Text="Command-line arguments"/>
			<WorkingDirectory Text="Working directory"/>
			<WorkingDirectoryDialogFilter Text="Folders"/>
			<IconFilePath Text="Custom icon path"/>
			<IconFilePathDialogFilter Text="Image files"/>
			<RunAsAdmin Text="Always run as administrator"/>
			<DeleteButton Text="Delete this app"/>
		</Elements>
		<MessageBox>
			<ConfirmDelete Text="Are you sure you want to delete {0}?"/>
			<ConfirmDeleteCaption Text="Confirm"/>
			<InvalidItem Text="Please enter a valid item. Name is empty or path is invalid."/>
			<InvalidItemCaption Text="Invalid item"/>
		</MessageBox>
		<FooterButtons>
			<OK Text="OK(_O)"/>
			<Apply Text="Apply(_A)"/>
			<Cancel Text="Cancel(_C)"/>
		</FooterButtons>
	</EditWindow>
	<TaskTrayIcon>
		<ShowMainWindow Text="Show main window(_M)"/>
		<ShowWidget Text="Show widget(_W)"/>
		<OpenSettings Text="Open settings(_S)"/>
		<OpenEdit Text="Edit apps(_E)"/>
		<Quit Text="Quit(_Q)"/>
	</TaskTrayIcon>
	<Reusable>
		<OpenFileDialogTitle Text="Select a file"/>
		<OpenFolderDialogTitle Text="Select a folder"/>
		<ErrorMessageBoxTitle Text="Error"/>
		<AddAppSuggest Text="Add an app! Drag&amp;drop to add."/>
	</Reusable>
	<Exception>
		<Color>
			<FromHtml>
				<EmptyText Text="Please enter a color code."/>
				<NoSharp Text="Color code must start with '#'."/>
				<InvalidText Text="Invalid color code."/>
			</FromHtml>
		</Color>
	</Exception>
</Language>
