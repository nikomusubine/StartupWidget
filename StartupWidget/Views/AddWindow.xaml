<Window x:Class="StartupWidget.Views.AddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StartupWidget.Views"
        mc:Ignorable="d"
        Title="AddWindow" Height="300" Width="500">
    <Grid>
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Vertical" Margin="0,0,0,0" Height="250">
                <!--設定-->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Height="20">
                    <TextBlock Text="Name" VerticalAlignment="Center" Margin="10,0,0,0" Width="120"/>
                    <TextBox  Text="{Binding AddingItem.Name}" Width="360"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Height="20">
                    <TextBlock Text="Path" VerticalAlignment="Center" Margin="10,0,0,0" Width="120"/>
                    <TextBox Text="{Binding AddingItem.FilePath}" Width="330"/>
                    <Button Content="..." Width="30" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Height="20">
                    <TextBlock Text="WorkingDirectory" VerticalAlignment="Center" Margin="10,0,0,0" Width="120"/>
                    <TextBox Text="{Binding AddingItem.WorkingDirectory}" Width="360"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Height="20">
                    <TextBlock Text="Comnmandline Args" VerticalAlignment="Center" Margin="10,0,0,0" Width="120"/>
                    <TextBox Text="{Binding AddingItem.Arguments}" Width="360"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Height="20">
                    <TextBlock Text="Run as admin" VerticalAlignment="Center" Margin="10,0,0,0" Width="120"/>
                    <CheckBox IsChecked="{Binding AddingItem.RunasAdmin}" Width="380"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Height="20">
                    <TextBlock Text="Custom icon path" VerticalAlignment="Center" Margin="10,0,0,0" Width="120"/>
                    <TextBox Text="{Binding AddingItem.IconPath}" Width="330"/>
                    <Button Content="..." Width="30" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Height="34">
                <Button Content="Cancel(_C)" Command="{Binding CancelButtonClickComand}" Width="60"/>
                <Button Content="OK(_A)" Command="{Binding OKButtonClickCommand}" Margin="5,0,0,0" Width="60"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
