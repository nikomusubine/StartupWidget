<Window x:Class="StartupWidget.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StartupWidget.Views"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:k="clr-namespace:StartupWidget.Controls"
        xmlns:loc="clr-namespace:StartupWidget.Views.Extensions"
        xmlns:bh="clr-namespace:StartupWidget.Behaviours"
        mc:Ignorable="d"
        Title="{loc:Lang MainWindow}" Height="450" Width="800"
        Background="{Binding BackgroundColor}"
        FontFamily="{Binding FontFamily}"
        FontSize="{Binding FontSize}"
        >
    <Window.Resources>
        <Style TargetType="ListView">
            <Setter Property="Foreground" Value="{Binding ForegroundColor}"/>
        </Style>
    </Window.Resources>
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{loc:Lang MainWindow/RightClickMenu/Run}" Command="{Binding StartProcessCommand}"/>
            <MenuItem Header="{loc:Lang MainWindow/RightClickMenu/RunAsAdmin}" Command="{Binding StartProcessAsAdminCommand}">
                <MenuItem.Icon>
                    <Image Source="{Binding ShieldIcon}" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Lang MainWindow/RightClickMenu/Edit}" Command="{Binding OpenEditWindowCommand}"/>
        </ContextMenu>
    </Window.ContextMenu>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding ClosingCommand}" PassEventArgsToCommand="True"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Margin="0,0,0,0" Focusable="True">
        <Menu IsMainMenu="True" Margin="0" VerticalAlignment="Top" FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}">
            <MenuItem  Header="{loc:Lang MainWindow/MainMenu/Options}" Margin="5,0">
                <MenuItem Header="{loc:Lang MainWindow/MainMenu/Options/ShowWidget}" Command="{Binding ShowWidgetCommand}" IsCheckable="True" IsChecked="{Binding IsWidgetShow}"/>
                <MenuItem Header="{loc:Lang MainWindow/MainMenu/Options/Settings}" Command="{Binding OpenSettingsCommand}"/>
                <MenuItem Header="{loc:Lang MainWindow/MainMenu/Options/Quit}" Command="{Binding QuitAppCommand}"/>
            </MenuItem>
        </Menu>

        <ListView Margin="10,20,10,10" ItemsSource="{Binding ProcessItems}" SelectedItem="{Binding SelectedItem}" 
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  bh:FileDropBehaviour.FileDropCommand="{Binding FileDropCommand}"                  >
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.Background>
                <ImageBrush ImageSource="{Binding ValidBackgroundImagePath, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
            </ListView.Background>

            <ListView.InputBindings>
                <KeyBinding Gesture="Enter" Command="{Binding StartProcessCommand}"/>
                <KeyBinding Gesture="Shift+Enter"  Command="{Binding StartProcessAsAdminCommand}"/>
            </ListView.InputBindings>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="PreviewMouseDoubleClick">
                    <i:InvokeCommandAction Command="{Binding StartProcessCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <i:Interaction.Behaviors>
                <bh:ListViewUnselectBehaviour/>
            </i:Interaction.Behaviors>
        </ListView>

    </Grid>
</Window>
