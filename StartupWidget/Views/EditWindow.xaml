<Window x:Class="StartupWidget.Views.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StartupWidget.Views"
        xmlns:loc="clr-namespace:StartupWidget.Views.Extensions"
        xmlns:diag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
        xmlns:dd="urn:gong-wpf-dragdrop"
        mc:Ignorable="d"
        Title="{loc:Lang EditWindow}" Height="450" Width="800"
        FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}">
    <Window.Resources>
        <Style x:Key="ProcessOptionElement" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ProcessItemWidth"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Margin="5,0" Text="{TemplateBinding Tag}"/>
                            <ContentPresenter Grid.Column="1"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFDDDDDD"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="BorderBrush" Value="#FF707070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"
                                      Margin="10,5"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFEBEE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFCDD2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="Gray"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="LightGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelButtonCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid Margin="0,20,0,45" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListView Grid.Column="0" Margin="10,0,5,0"
                      ItemsSource="{Binding ProcessItems}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" 
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>

            <StackPanel Grid.Column="1" Margin="5,0"  Grid.IsSharedSizeScope="True" IsEnabled="{Binding IsSelected}">
                <ContentControl  Style="{StaticResource ProcessOptionElement}" Tag="{loc:Lang EditWindow/Elements/Name}">
                    <TextBox Text="{Binding Name}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderBrush" Value="#FFABADB3"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NameErrorVisible}" Value="True">
                                        <Setter Property="BorderBrush" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </ContentControl>
                <ContentControl Style="{StaticResource ProcessOptionElement}" Tag="{loc:Lang EditWindow/Elements/FilePath}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="BorderBrush" Value="#FFABADB3"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilePathErrorVisible}" Value="True">
                                            <Setter Property="BorderBrush" Value="Red"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="1" Content="..." Margin="5,0,0,0" Padding="5,0" Command="{Binding BrowseExeFileCommand}"/>
                    </Grid>
                </ContentControl>
                <ContentControl Style="{StaticResource ProcessOptionElement}" Tag="{loc:Lang EditWindow/Elements/Arguments}">
                    <TextBox Text="{Binding Arguments}"/>
                </ContentControl>
                <ContentControl Style="{StaticResource ProcessOptionElement}" Tag="{loc:Lang EditWindow/Elements/WorkingDirectory}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="..." Margin="5,0,0,0" Padding="5,0" Command="{Binding BrowseWorkingDirectoryCommand}"/>
                    </Grid>
                </ContentControl>
                <ContentControl Style="{StaticResource ProcessOptionElement}" Tag="{loc:Lang EditWindow/Elements/IconFilePath}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding IconFilePath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="..." Margin="5,0,0,0" Padding="5,0" Command="{Binding BrowseIconFileCommand}"/>
                    </Grid>
                </ContentControl>
                <ContentControl Style="{StaticResource ProcessOptionElement}" Tag="{loc:Lang EditWindow/Elements/RunAsAdmin}">
                    <CheckBox IsChecked="{Binding RunAsAdmin}" VerticalAlignment="Center"/>
                </ContentControl>
                <Button Content="{loc:Lang EditWindow/Elements/DeleteButton}" Command="{Binding RemoveAppCommand}"
                        Foreground="Red" HorizontalAlignment="Left" Padding="5,0" Margin="10,15,0,0"
                        Style="{StaticResource DangerButtonStyle}"/>
            </StackPanel>
        </Grid>
        
        
        <Grid Margin="10,10,10,10" VerticalAlignment="Bottom" Grid.IsSharedSizeScope="True" Height="25" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ButtonWidth"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ButtonWidth"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ButtonWidth"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="5,0" Padding="5,0" Content="{loc:Lang EditWindow/FooterButtons/OK}" Command="{Binding OKButtonCommand}" />
            <Button Grid.Column="1" Margin="5,0" Padding="5,0" Content="{loc:Lang EditWindow/FooterButtons/Apply}" Command="{Binding ApplyButtonCommand}" />
            <Button Grid.Column="2" Margin="5,0" Padding="5,0" Content="{loc:Lang EditWindow/FooterButtons/Cancel}" Command="{Binding CancelButtonCommand}" />
        </Grid>
    </Grid>
</Window>
