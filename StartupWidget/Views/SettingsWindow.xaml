<Window x:Class="StartupWidget.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StartupWidget.Views"
        xmlns:loc="clr-namespace:StartupWidget.Views.Extensions"
        mc:Ignorable="d"
        Title="{loc:Lang SettingsWindow}" Height="450" Width="800"
        FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}">
    <Window.Resources>
        <local:SettingsItemTemplateSelector
            x:Key="settingsItemTemplateSelector"
            BoolTemplate="{StaticResource BoolTemplate}"
            StringTemplate="{StaticResource StringTemplate}"
            IntTemplate="{StaticResource IntTemplate}"
            FloatTemplate="{StaticResource FloatTemplate}"
            LimitedIntTemplate="{StaticResource LimitedIntTemplate}"
            LimitedFloatTemplate="{StaticResource LimitedFloatTemplate}"
            OptionalStringTemplate="{StaticResource OptionalStringTemplate}"
            FontTemplate="{StaticResource FontTemplate}"
            FilePathTemplate="{StaticResource FilePathTemplate}"
            ColorTemplate="{StaticResource ColorTemplate}"
            ShortcutKeyTemplate="{StaticResource ShortcutKeyTemplate}"/>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Gesture="Escape" Command="{Binding EscapeKeyCommand}"/>
    </Window.InputBindings>
    <Grid>
        <TabControl Grid.Column="0" Margin="10,10,10,40">
            <TabItem Header="{loc:Lang SettingsWindow/GeneralSettings}">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding GeneralSettingsItems}"
                      ItemTemplateSelector="{StaticResource settingsItemTemplateSelector}"
                      Grid.IsSharedSizeScope="True" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Lang SettingsWindow/MainWindowSettings}">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding MainWindowSettingsItems}"
          ItemTemplateSelector="{StaticResource settingsItemTemplateSelector}"
          Grid.IsSharedSizeScope="True" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Lang SettingsWindow/WidgetSettings}">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding WidgetSettingsItems}"
ItemTemplateSelector="{StaticResource settingsItemTemplateSelector}"
Grid.IsSharedSizeScope="True" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Grid Margin="10,10,10,10" VerticalAlignment="Bottom" Grid.IsSharedSizeScope="True" Height="25" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ButtonWidth"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ButtonWidth"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ButtonWidth"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="5,0" Padding="5,0" Content="OK(_O)" Command="{Binding OKSettingsCommand}" />
            <Button Grid.Column="1" Margin="5,0" Padding="5,0" Content="適用(_A)" Command="{Binding ApplySettingsCommand}" />
            <Button Grid.Column="2" Margin="5,0" Padding="5,0" Content="キャンセル(_C)" Command="{Binding CancelSettingsCommand}" />
        </Grid>
    </Grid>
</Window>
