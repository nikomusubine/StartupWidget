<Application x:Class="StartupWidget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StartupWidget"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Templates/ProcessItemViewModelTemplate.xaml"/>
                <ResourceDictionary Source="/Templates/SettingsElementTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <XmlDataProvider x:Key="Lang" Source="pack://siteoforigin:,,,/Languages/ja-JP.xml"
                             IsAsynchronous="False"/> 

        </ResourceDictionary>
    </Application.Resources>
</Application>
