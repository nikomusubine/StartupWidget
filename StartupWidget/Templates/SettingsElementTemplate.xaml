<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:k="clr-namespace:StartupWidget.Controls"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:b="clr-namespace:StartupWidget.Behaviours">

    <Style x:Key="SettingItemLayoutStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelWidth"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="5,0" Text="{Binding Name}" />
                        <ContentPresenter Grid.Column="1"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="BoolTemplate">
        <ContentControl Style="{StaticResource SettingItemLayoutStyle}">
            <CheckBox IsChecked="{Binding Value}"/>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="StringTemplate">
        <ContentControl Style="{StaticResource SettingItemLayoutStyle}">
            <TextBox Text="{Binding Value}"/>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="IntTemplate">
        <ContentControl Style="{StaticResource SettingItemLayoutStyle}">
            <k:IntNumericBox Text="{Binding Value}"/>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="FloatTemplate">
        <ContentControl Style="{StaticResource SettingItemLayoutStyle}">
            <k:FloatNumericBox Text="{Binding Value}"/>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="LimitedIntTemplate">
        <ContentControl Style="{StaticResource SettingItemLayoutStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <k:IntNumericBox Grid.Column="0" IsLimited="True" MaxValue="{Binding MaxValue}" MinValue="{Binding MinValue}" Text="{Binding SliderValue}"/>
                <Slider Grid.Column="1" Margin="5,0" Minimum="{Binding SliderMinimum}" Maximum="{Binding SliderMaximum}" Value="{Binding SliderValue}" IsSnapToTickEnabled="True" TickFrequency="1"/>
            </Grid>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="LimitedFloatTemplate">
        <ContentControl Style="{StaticResource SettingItemLayoutStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <k:FloatNumericBox Grid.Column="0" IsLimited="True" MaxValue="{Binding MaxValue}" MinValue="{Binding MinValue}" Text="{Binding SliderValue}"/>
                <Slider Grid.Column="1" Margin="5,0" Minimum="{Binding SliderMinimum}" Maximum="{Binding SliderMaximum}" Value="{Binding SliderValue}"/>
            </Grid>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="OptionalStringTemplate">
        <ContentControl Style="{StaticResource SettingItemLayoutStyle}">
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" />
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="FontTemplate">
        <ContentControl Style="{StaticResource SettingItemLayoutStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding Value}" Width="150"/>
                    <k:FloatNumericBox Grid.Column="1" IsLimited="True" MinValue="1" Text="{Binding Size}"/>
            </Grid>
        </ContentControl>
    </DataTemplate>
    <DataTemplate x:Key="FilePathTemplate">
        <ContentControl Style="{StaticResource SettingItemLayoutStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Content="..." Margin="5,0" Padding="5,0" Command="{Binding BrowseFileCommand}"/>
            </Grid>
        </ContentControl>
    </DataTemplate>
    <DataTemplate x:Key="ColorTemplate"> <!-- いずれ画面内で色を選択できるように改造する -->
        <ContentControl Style="{StaticResource SettingItemLayoutStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding ColorName, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Content="..." Margin="5,0" Padding="5,0" Command="{Binding ColorSelectCommand}"/>
            </Grid>
        </ContentControl>
    </DataTemplate>
    
    <DataTemplate x:Key="ShortcutKeyTemplate">
        <ContentControl Style="{StaticResource SettingItemLayoutStyle}">
            <TextBox Grid.Column="0" Text="" IsReadOnly="True">
                <i:Interaction.Behaviors>
                    <b:ShortcutKeySetBehaviour ShortcutKeys="{Binding Value, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                </i:Interaction.Behaviors>
            </TextBox>
        </ContentControl>
    </DataTemplate>
</ResourceDictionary>