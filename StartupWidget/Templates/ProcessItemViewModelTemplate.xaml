<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:StartupWidget.ViewModels.Items"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:dd="urn:gong-wpf-dragdrop">

    <DataTemplate x:Key="ProcessItemTemplateBase" DataType="{x:Type local:ProcessItemViewModel}">
        <Grid Width="Auto">
            <Grid.RowDefinitions>
                <RowDefinition  Height="64" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Image Grid.Row="0" Source="{Binding IconImage}" />
            <TextBlock Grid.Row="1"  Text="{Binding Name}" TextWrapping="Wrap" Margin="5,0" HorizontalAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:ProcessItemViewModel}">
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProcessItemTemplateBase}"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:AddItemButtonViewModel}">
        <ContentControl dd:DragDrop.DragSourceIgnore="True" Content="{Binding}" ContentTemplate="{StaticResource ProcessItemTemplateBase}"/>
    </DataTemplate>
</ResourceDictionary>