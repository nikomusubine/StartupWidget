<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:StartupWidget.ViewModels.Items"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:dd="urn:gong-wpf-dragdrop">

    <DataTemplate x:Key="ProcessItemTemplateBase" DataType="{x:Type local:ProcessItemViewModel}">
        <Grid Width="{Binding Path=DataContext.ProcessItemWidth, RelativeSource={RelativeSource AncestorType=Window}}"
              Height="{Binding Path=DataContext.ProcessItemHeight, RelativeSource={RelativeSource AncestorType=Window}}"
              ToolTip="{Binding Name}">
            <Grid.RowDefinitions>
                <RowDefinition  Height="{Binding Path=DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Stretch="Uniform" Source="{Binding IconImage}"/>
                <Image Grid.Row="1" Grid.Column="1" Stretch="Uniform" Source="{Binding ShieldIcon,TargetNullValue={x:Null}}"/>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="WrapWithOverflow" Margin="-3,2" 
                       TextAlignment="Center" MaxHeight="{Binding Path=DataContext.TextHeight,RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:ProcessItemViewModel}">
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProcessItemTemplateBase}"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:AddItemButtonViewModel}">
        <ContentControl dd:DragDrop.DragSourceIgnore="True" Content="{Binding}" ContentTemplate="{StaticResource ProcessItemTemplateBase}"/>
    </DataTemplate>
</ResourceDictionary>