<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:StartupWidget.ViewModels.Items"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">


    <DataTemplate DataType="{x:Type local:ProcessItemViewModel}">
        <Grid Width="Auto">
            <Grid.RowDefinitions>
                <RowDefinition  Height="64" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Image Grid.Row="0" Source="{Binding IconImage}" />
            <TextBlock Grid.Row="1"  Text="{Binding Name}" TextWrapping="Wrap" Margin="5,0,0,0"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>